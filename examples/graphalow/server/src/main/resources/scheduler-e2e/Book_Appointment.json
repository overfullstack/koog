			"name": "Auth With Credentials",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseBody = pm.response.text();",
							"const responseXml = pm.response.text();",
							"const responseJson = xml2Json(responseXml);",
							"const sessionIdValue = responseJson['soapenv:Envelope']['soapenv:Body'].loginResponse.result.sessionId;",
